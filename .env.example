# Servidor
PUERTO=3001
HOST_API=127.0.0.1
NODE_ENV=production

# SQL Server — BD propia del bot (elementos_monitoreados, dependencias_elemento)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=BotMonitoreo
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=false

# SQL Server — Repositorio de Informatica PowerCenter (REP_WFLOW_RUN, etc. — solo lectura)
INFORMATICA_HOST=
INFORMATICA_PORT=1433
INFORMATICA_DATABASE=
INFORMATICA_USERNAME=
INFORMATICA_PASSWORD=
INFORMATICA_ENCRYPT=false

# Active Directory
AD_URL=ldap://dccor02.gviz.com:389
AD_DOMINIO=gviz.com

# JWT
JWT_SECRET=
JWT_EXPIRACION=8h

# Cifrado de contraseñas guardadas para conexiones de validación (mínimo 32 caracteres)
CIFRADO_CONFIG_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODELO=gemini-1.5-flash-latest
GEMINI_TEMPERATURA=0.1

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
ALERTA_DESTINATARIOS_DEFAULT=


URL_DASHBOARD=http://localhost:3000
# Polling
INTERVALO_POLLING_SEGUNDOS=30
